# Временные файлы сборки и бинарники прошивки Gowin
/impl/
*.log
*.rpt
*.gprj.user
*.zip

# Секретные исходники логики, которые вы хотите оставить приватными
# (просто создайте в проекте папку private_rtl и кладите их туда)
/private_rtl/


# ==========================================
# === Временные файлы сборки и логов Qt ===
# ==========================================

# Игнорируем ВСЕ папки сборки Qt Creator (Shadow builds)
# Они обычно называются build-ИмяПроекта-Desktop...
build-*/

# Пользовательские файлы настроек Qt Creator (там хранятся пути и история открытых файлов конкретно вашего ПК)
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*

# Временный кэш CMake и файлы сборки (если проект на CMake, а не на qmake)
CMakeLists.txt.user
/CMakeCache.txt
/CMakeFiles/
/CMakeScripts/
/Makefile
/cmake_install.cmake
/CMakeSettings.json

# Компилированные файлы и бинарники (выхлоп C++)
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.ilk
*.pdb
*.exp

# Служебные файлы прекомпилятора Qt (MOC, RCC, UIC)
# Qt Creator генерирует их из ваших исходников на лету
moc_*.cpp
qrc_*.cpp
ui_*.h