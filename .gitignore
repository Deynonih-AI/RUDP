# ==========================================
# === Gowin FPGA ===
# ==========================================
# Временные файлы сборки и бинарники прошивки
/impl/
*.log
*.rpt
*.gprj.user
*.zip

# Файлы прошивки (битстримы). Уберите эти строки, если хотите хранить их в репозитории
*.sbit
*.fs
*.rbf

# ==========================================
# === QuestaSim / ModelSim ===
# ==========================================
# Папка скомпилированных библиотек
work/
# Логи и временные файлы
transcript
vsim.wlf
*.vcd
*.wlf
*.vstf
*.qdb
*.ucdb

# ==========================================
# === Приватные исходники ===
# ==========================================
# Секретные исходники логики, которые вы хотите оставить приватными
# (просто создайте в проекте папку private_rtl и кладите их туда)
/private_rtl/

# ==========================================
# === Временные файлы сборки и логов Qt ===
# ==========================================
# Игнорируем ВСЕ папки сборки Qt Creator (Shadow builds)
build-*/

# Пользовательские файлы настроек Qt Creator
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*

# Временный кэш CMake и файлы сборки
CMakeLists.txt.user
/CMakeCache.txt
/CMakeFiles/
/CMakeScripts/
/Makefile
/cmake_install.cmake
/CMakeSettings.json

# Компилированные файлы и бинарники (выхлоп C++)
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.ilk
*.pdb
*.exp

# Служебные файлы прекомпилятора Qt (MOC, RCC, UIC)
moc_*.cpp
qrc_*.cpp
ui_*.h

# ==========================================
# === Прочее (ОС и IDE) ===
# ==========================================
# Мусор операционных систем
.DS_Store
Thumbs.db

# Настройки редакторов кода (если используете VS Code или CLion)
.vscode/
.idea/

# Кэш Python (если в проекте есть Python-скрипты)
__pycache__/
*.py[cod]
.venv/