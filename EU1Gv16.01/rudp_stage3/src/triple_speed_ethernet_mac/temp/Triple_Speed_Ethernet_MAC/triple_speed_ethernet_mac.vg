    .rgmii_txc(rgmii_txc),
    .rx_statistics_vector(rx_statistics_vector[26:0]),
    .rx_pause_val(rx_pause_val[15:0]),
    .rx_mac_data(rx_mac_data[7:0]),
    .tx_statistics_vector(tx_statistics_vector[28:0]),
    .miim_rddata(miim_rddata[15:0]),
    .rgmii_txd(rgmii_txd[3:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
assign rx_mac_clk = rgmii_rxc;
assign tx_mac_clk = gtx_clk;
assign rx_pause_req = rx_statistics_vector[5];
