  mdio_out,
  mdio_oen
)
;
input rgmii_rxc;
input rgmii_rx_ctl;
input [3:0] rgmii_rxd;
input gtx_clk;
output rgmii_txc;
output rgmii_tx_ctl;
output [3:0] rgmii_txd;
input speedis1000;
input speedis10;
input duplex_status;
input rstn;
output rx_mac_clk;
output rx_mac_valid;
output [7:0] rx_mac_data;
output rx_mac_last;
output rx_mac_error;
output rx_statistics_valid;
output [26:0] rx_statistics_vector;
output tx_mac_clk;
input tx_mac_valid;
input [7:0] tx_mac_data;
input tx_mac_last;
input tx_mac_error;
output tx_mac_ready;
output tx_collision;
output tx_retransmit;
output tx_statistics_valid;
output [28:0] tx_statistics_vector;
input rx_fcs_fwd_ena;
input rx_jumbo_ena;
output rx_pause_req;
output [15:0] rx_pause_val;
input tx_fcs_fwd_ena;
input tx_ifg_delay_ena;
input [7:0] tx_ifg_delay;
input tx_pause_req;
input [15:0] tx_pause_val;
