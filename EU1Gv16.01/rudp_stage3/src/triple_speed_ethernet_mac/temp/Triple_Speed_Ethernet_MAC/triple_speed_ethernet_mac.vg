    .rstn(rstn),
    .speedis10(speedis10),
    .tx_mac_data(tx_mac_data[7:0]),
    .tx_pause_source_addr(tx_pause_source_addr[47:0]),
    .tx_pause_val(tx_pause_val[15:0]),
