`pragma protect end_protected
module gowin_dc_fifo (
  Data,
  WrReset,
  RdReset,
  WrClk,
  RdClk,
  WrEn,
  RdEn,
  Almost_Full,
  Q,
  Empty,
  Full
)
;
input [7:0] Data;
input WrReset;
input RdReset;
input WrClk;
input RdClk;
input WrEn;
input RdEn;
output Almost_Full;
output [7:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.gowin_dc_fifo  fifo_inst (
    .RdClk(RdClk),
    .RdReset(RdReset),
    .WrClk(WrClk),
    .WrReset(WrReset),
    .WrEn(WrEn),
    .RdEn(RdEn),
    .Data(Data[7:0]),
    .Empty(Empty),
    .Almost_Full(Almost_Full),
    .Full(Full),
    .Q(Q[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* gowin_dc_fifo */
