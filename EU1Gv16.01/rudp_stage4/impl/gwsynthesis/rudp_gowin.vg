module gw_pll_100_25 (
  gen_clk_100m_d,
  ckxtail1_fpga_d
)
;
input gen_clk_100m_d;
output ckxtail1_fpga_d;
wire clkoutp_o;
wire clkoutd_o;
wire clkoutd3_o;
wire lock;
wire VCC;
wire GND;
  rPLL rpll_inst (
    .CLKOUT(ckxtail1_fpga_d),
    .CLKOUTP(clkoutp_o),
    .CLKOUTD(clkoutd_o),
    .CLKOUTD3(clkoutd3_o),
    .LOCK(lock),
    .CLKIN(gen_clk_100m_d),
    .CLKFB(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .ODSEL({GND,GND,GND,GND,GND,GND}),
    .DUTYDA({GND,GND,GND,GND}),
    .PSDA({GND,GND,GND,GND}),
    .FDLY({GND,GND,GND,GND}),
    .RESET(GND),
    .RESET_P(GND) 
);
defparam rpll_inst.CLKFB_SEL="internal";
