module gowin_dc_fifo (
  wr_en,
  \phy_rx_sync.val ,
  led_d_1_4,
  ckxtail1_fpga_d,
  rgmii_rx_clk_d,
  rx_mac_last_o,
  phy_rx_dat,
  full,
  empty,
  \phy_rx_sync.dat 
)
;
input wr_en;
input \phy_rx_sync.val ;
input led_d_1_4;
input ckxtail1_fpga_d;
input rgmii_rx_clk_d;
input rx_mac_last_o;
input [7:0] phy_rx_dat;
output full;
output empty;
output [7:0] \phy_rx_sync.dat ;
wire VCC;
wire GND;
  \~fifo.gowin_dc_fifo  fifo_inst (
    .wr_en(wr_en),
    .\phy_rx_sync.val (\phy_rx_sync.val ),
    .led_d_1_4(led_d_1_4),
    .ckxtail1_fpga_d(ckxtail1_fpga_d),
    .rgmii_rx_clk_d(rgmii_rx_clk_d),
    .rx_mac_last_o(rx_mac_last_o),
    .phy_rx_dat(phy_rx_dat[7:0]),
    .full(full),
    .empty(empty),
    .\phy_rx_sync.dat (\phy_rx_sync.dat [7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* gowin_dc_fifo */
module mac_vlg_cdc_gowin (
  phy_rx_val,
  \phy_rx_sync.val ,
  led_d_1_4,
  ckxtail1_fpga_d,
  rgmii_rx_clk_d,
  rx_mac_last_o,
  phy_rx_dat,
  empty,
  \phy_rx_sync.dat 
)
;
input phy_rx_val;
input \phy_rx_sync.val ;
input led_d_1_4;
input ckxtail1_fpga_d;
input rgmii_rx_clk_d;
input rx_mac_last_o;
input [7:0] phy_rx_dat;
output empty;
output [7:0] \phy_rx_sync.dat ;
wire wr_en;
wire full;
wire VCC;
wire GND;
  LUT2 wr_en_s0 (
    .F(wr_en),
    .I0(full),
    .I1(phy_rx_val) 
);
defparam wr_en_s0.INIT=4'h4;
  gowin_dc_fifo dc_fifo (
    .wr_en(wr_en),
    .\phy_rx_sync.val (\phy_rx_sync.val ),
    .led_d_1_4(led_d_1_4),
    .ckxtail1_fpga_d(ckxtail1_fpga_d),
    .rgmii_rx_clk_d(rgmii_rx_clk_d),
    .rx_mac_last_o(rx_mac_last_o),
    .phy_rx_dat(phy_rx_dat[7:0]),
    .full(full),
    .empty(empty),
    .\phy_rx_sync.dat (\phy_rx_sync.dat [7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* mac_vlg_cdc_gowin */
